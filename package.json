{
  "name": "warm-glass-ppt-skill-repository",
  "version": "1.3.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Editable PPT skill for reports, talks, training and product introductions, with warm glass styling.",
  "license": "MIT",
  "workspaces": ["skills/warm-glass-ppt"],
  "scripts": {
    "demo": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/compose/content-led.json --out dist/compose",
    "demo:components": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/ui/components.json --out dist/ui/components",
    "demo:content:report": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/compose/report.json --out dist/content/report",
    "demo:content:talk": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/compose/talk.json --out dist/content/talk",
    "demo:content:training": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/compose/training.json --out dist/content/training",
    "demo:content:product": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/compose/product.json --out dist/content/product",
    "demo:report": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/ui/report.json --out dist/ui/report",
    "demo:talk": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/ui/talk.json --out dist/ui/talk",
    "demo:training": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/ui/training.json --out dist/ui/training",
    "demo:product": "node skills/warm-glass-ppt/scripts/build-ui.mjs skills/warm-glass-ppt/examples/ui/product.json --out dist/ui/product",
    "demo:legacy": "node skills/warm-glass-ppt/scripts/build.mjs skills/warm-glass-ppt/examples/showcase.json --out dist/legacy",
    "test": "node --test tests/*.test.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "install:skill": "node scripts/install-skill.mjs",
    "package:skill": "node scripts/package-release.mjs"
  },
  "overrides": {"image-size": "2.0.3"},
  "engines": {"node": ">=20.9.0"}
}
